{
    "manifest_version": 3,
    "name": "Story Mood Playlist",
    "version": "1.0",
    "description": "Suggests Spotify playlists based on the mood of the content you're reading.",
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": "icons/icon48.png"
    },
    "permissions": [
      "activeTab",
      "scripting",
      "identity",
      "storage"
    ],
    "host_permissions": [
      "https://*.spotify.com/*",
      "*://*/*",
      "https://api.spotify.com/*",
      "https://accounts.spotify.com/*",
      "https://api-inference.huggingface.co/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }